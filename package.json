{
  "name": "@kungfu-tech/libnode",
  "author": {
    "name": "kungfu-trader",
    "email": "info@kungfu.link"
  },
  "version": "22.22.3-kf.5-alpha.4",
  "description": "Build shared node lib",
  "license": "Apache-2.0",
  "main": "src/js/index.js",
  "repository": {
    "url": "https://github.com/kungfu-systems/libnode.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    ".gyp/*.js",
    ".gyp/*.py",
    "src/",
    "binding.gyp",
    "libnode.release.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "install": "node .gyp/noop-install.js",
    "build": "node .gyp/node-build.js build",
    "clean": "node .gyp/node-build.js clean",
    "dist": "node .gyp/node-dist.js",
    "make": "node .gyp/node-make.js",
    "package": "node .gyp/node-platform-package.js pack",
    "package:main": "node .gyp/node-platform-package.js pack-main",
    "package:platform": "node .gyp/node-platform-package.js pack-platform",
    "prepare-node-source": "node .gyp/node-source-prepare.js",
    "rebuild": "node .gyp/node-build.js rebuild",
    "verify-release": "node .gyp/libnode-release-verify.js",
    "sync-kfd-witnesses": "node .gyp/libnode-kfd-witnesses.js write",
    "verify-kfd-witnesses": "node .gyp/libnode-kfd-witnesses.js check",
    "verify-kfd3-artifact": "node .gyp/libnode-kfd3-artifact-verify.js",
    "verify-package-source": "node .gyp/node-platform-package.js verify-source",
    "format": "prettier --write --parser typescript .gyp/*.js src/js/*.js"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "sywac": "^1.3.0"
  },
  "devDependencies": {
    "fs-extra": "^11.3.6",
    "glob": "^13.0.6",
    "node-addon-api": "^8.9.0",
    "node-gyp": "^13.0.0",
    "prettier": "^3.9.4",
    "xml-js": "^1.6.11"
  }
}
